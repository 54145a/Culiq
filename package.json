{
	"name": "@54145a/culiq",
	"version": "1.3.0",
	"type": "module",
	"packageManager": "pnpm@12.2.1",
	"description": "Culiq — browser agent Chrome extension",
	"engines": {
		"node": ">=22.18"
	},
	"scripts": {
		"dev": "TARGET=chrome vite",
		"dev:firefox": "TARGET=firefox vite",
		"build": "pnpm run build:chrome && pnpm run build:firefox",
		"build:chrome": "TARGET=chrome vite build",
		"build:firefox": "TARGET=firefox vite build",
		"mcp:server": "pnpx --yes @modelcontextprotocol/server-everything streamableHttp",
		"test": "pnpm test:opfs && pnpm test:session-export && pnpm test:page-share && pnpm test:sandbox && pnpm test:mcp",
		"test:mcp": "node scripts/mcp-smoke.mjs",
		"test:opfs": "node scripts/opfs-smoke.mjs",
		"test:page-share": "node scripts/page-share-smoke.mjs",
		"test:session-export": "node scripts/session-export-smoke.mjs",
		"test:sandbox": "node scripts/sandbox-worker-smoke.mjs",
		"check": "tsc --noEmit && tsc -p tsconfig.node.json --noEmit && tsc -p scripts/tsconfig.json --noEmit",
		"lint": "oxlint --type-aware",
		"lint:fix": "oxlint --type-aware --fix"
	},
	"devDependencies": {
		"@crxjs/vite-plugin": "^2.7.1",
		"@types/chrome": "^0.2.9",
		"@types/node": "^26.6.5",
		"oxlint": "^1.87.0",
		"oxlint-tsgolint": "^7.0.2004",
		"typescript": "^7.0.2",
		"vite": "^8.3.4",
		"web-ext": "^10.7.0"
	},
	"dependencies": {
		"@ai-sdk/anthropic": "^4.0.78",
		"@ai-sdk/mcp": "^2.0.73",
		"@ai-sdk/openai-compatible": "^3.0.67",
		"@ai-sdk/react": "^4.0.140",
		"@humanfs/core": "0.20.0",
		"@humanfs/web": "0.15.0",
		"acorn": "^8.19.0",
		"ai": "^7.0.137",
		"defuddle": "^0.19.5",
		"marked": "^18.1.0",
		"preact": "^11.0.1",
		"tokenx": "^2.1.1",
		"zod": "^4.6.5"
	},
	"allowScripts": {
		"esbuild@0.25.12": true,
		"spawn-sync@1.0.15": true
	}
}
