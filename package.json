{
	"name": "@54145a/culiq",
	"version": "1.0.0",
	"type": "module",
	"packageManager": "pnpm@12.2.1",
	"description": "Culiq — browser agent Chrome extension",
	"scripts": {
		"dev": "TARGET=chrome vite",
		"dev:firefox": "TARGET=firefox vite",
		"build": "pnpm run build:chrome && pnpm run build:firefox",
		"build:chrome": "TARGET=chrome vite build",
		"build:firefox": "TARGET=firefox vite build",
		"mcp:server": "pnpx --yes @modelcontextprotocol/server-everything streamableHttp",
		"test:mcp": "node scripts/mcp-smoke.mjs",
		"test:sandbox": "node scripts/sandbox-worker-smoke.mjs",
		"check": "tsc --noEmit && tsc -p tsconfig.node.json --noEmit && tsc -p scripts/tsconfig.json --noEmit",
		"lint": "oxlint --type-aware",
		"lint:fix": "oxlint --type-aware --fix"
	},
	"devDependencies": {
		"@crxjs/vite-plugin": "^2.7.1",
		"@types/chrome": "^0.2.6",
		"@types/node": "^26.2.0",
		"oxlint": "^1.81.0",
		"oxlint-tsgolint": "^7.0.2001",
		"typescript": "^7.0.2",
		"vite": "^8.2.1",
		"web-ext": "^10.6.0"
	},
	"dependencies": {
		"@ai-sdk/anthropic": "^4.0.39",
		"@ai-sdk/mcp": "^2.0.32",
		"@ai-sdk/openai-compatible": "^3.0.30",
		"@ai-sdk/react": "^4.0.69",
		"ai": "^7.0.66",
		"marked": "^18.0.9",
		"preact": "^10.29.8",
		"tokenx": "^2.1.0",
		"zod": "^4.4.3"
	},
	"allowScripts": {
		"esbuild@0.25.12": true,
		"spawn-sync@1.0.15": true
	}
}
